#
# Run the complete Python test suite from the locked environment. Run `uv sync --locked`
# once after cloning; install uv from https://docs.astral.sh/uv/ if it is unavailable.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v uv >/dev/null 2>&1; then
    echo "uv is required; install it from https://docs.astral.sh/uv/" >&2
    exit 1
fi

exec uv run --locked pytest "$@"
